{
  "name": "axtr-to-playwright",
  "version": "0.1.0",
  "description": "Chrome/Edge extension (Manifest V3) that converts D365 Task Recorder .axtr recordings into Playwright test scripts.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.270",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
